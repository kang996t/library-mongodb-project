# MongoDB 单机实例连接参数
MONGODB_URI=mongodb://<mongo-host>:27018/
MONGODB_DB_NAME=smart_library

# Python 应用运行账号。建议使用具有业务读写权限的 libWriter
MONGODB_APP_USER=libWriter
MONGODB_APP_PASSWORD=<replace-with-app-password>
MONGODB_AUTH_SOURCE=smart_library

MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=5000

# 任务三账号创建与权限边界验证所需的本地密码
MONGODB_READER_PASSWORD=<replace-with-reader-password>
MONGODB_WRITER_PASSWORD=<replace-with-writer-password>
MONGODB_ADMIN_PASSWORD=<replace-with-admin-password>